---
export function getStaticPaths() {
  const modules = import.meta.glob('../../*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => ({
    params: { slug: path.split('/').pop().replace(/\.md$/, '') },
    props: { mod },
  }));
}

const { mod } = Astro.props;
const Content = mod.Content;
const title = mod.frontmatter?.title ?? Astro.params.slug.replace(/-/g, ' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Performance Guides</title>
    <style is:global>
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.7;
        color: #1f2328;
        background: #fff;
      }
      article {
        max-width: 46rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      h1,
      h2,
      h3 {
        line-height: 1.3;
      }
      h1,
      h2 {
        border-bottom: 1px solid #d0d7de;
        padding-bottom: 0.4rem;
      }
      code {
        background: #f6f8fa;
        padding: 0.15em 0.4em;
        border-radius: 6px;
        font-size: 85%;
      }
      pre {
        background: #f6f8fa;
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
      }
      pre code {
        background: none;
        padding: 0;
      }
      table {
        border-collapse: collapse;
      }
      th,
      td {
        border: 1px solid #d0d7de;
        padding: 0.4rem 0.7rem;
      }
      img {
        max-width: 100%;
      }
      .back {
        display: inline-block;
        margin-bottom: 1.5rem;
        color: #0969da;
        text-decoration: none;
      }
      .back:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <article>
      <a href="/" class="back">&larr; All guides</a>
      <Content />
    </article>
  </body>
</html>
